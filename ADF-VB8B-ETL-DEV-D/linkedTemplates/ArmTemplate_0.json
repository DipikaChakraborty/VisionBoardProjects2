										"type": "Expression"
									},
									"directory": {
										"value": "@concat(\r\n    activity('LKUP_JOB_DETAILS').output.firstRow.targetdirectory, '/',\r\n    formatDateTime(utcNow(), 'yyyy'), '/',\r\n    formatDateTime(utcNow(), 'MM'), '/',\r\n    formatDateTime(utcNow(), 'dd'), '/'\r\n)",
